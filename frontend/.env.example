# API base URL. Vuoto = path relativi (FrankenPHP serve /api sulla stessa origin): è l'unica configurazione supportata.
# La sessione è un cookie della stessa origine e il backend rifiuta le scritture da un'altra origine (CSRF), quindi un
# frontend servito altrove (VITE_API_URL verso un altro host) può leggere ma non accedere né salvare.
VITE_API_URL=

# VAPID public key per Web Push subscription.
# Copia il valore di VAPID_PUBLIC_KEY dal .env root.
VITE_VAPID_PUBLIC_KEY=
