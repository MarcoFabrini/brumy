# --- Required -------------------------------------------------------------------------------------

DOMAIN=brumy.yourdomain.com

MARIADB_DATABASE=brumy
MARIADB_USER=brumy

# generate with: openssl rand -hex 32
MARIADB_PASSWORD=
APP_SECRET=

# --- Image and ports ------------------------------------------------------------------------------

BRUMY_REGISTRY=ghcr.io/marcofabrini
BRUMY_TAG=latest
API_PORT=8080

# --- API documentation ----------------------------------------------------------------------------

# Interactive OpenAPI docs (/api/doc) and raw spec (/api/doc.json), served without login.
# Off by default (both answer 404). Set to true to expose them: anyone who can reach the instance can read them.
API_DOC_ENABLED=false

# --- Email (optional) -----------------------------------------------------------------------------

#MAILER_DSN=smtp://user:password@smtp.example.com:587
#MAILER_FROM=noreply@yourdomain.com

# --- Overrides (optional) -------------------------------------------------------------------------
# Sane defaults are derived automatically, see compose.yml and entrypoint.sh.

#CORS_ALLOW_ORIGIN=
#FRONTEND_URL=https://brumy.yourdomain.com
#DEFAULT_URI=https://brumy.yourdomain.com
#TRUSTED_PROXIES=REMOTE_ADDR

# Calendar time zone of the instance, used for reminder due dates (default Europe/Rome).
#APP_TIMEZONE=Europe/Rome

# --- Limits (optional) ----------------------------------------------------------------------------

# Maximum attachment storage per organization, in MB (default 1024 = 1 GiB, 0 = no limit).
# On top of that: at most 20 files per record (vehicle, maintenance, expense...).
#ATTACHMENTS_ORG_QUOTA_MB=1024

# Maximum number of vehicles per organization, archived ones included (default 0 = no limit).
#VEHICLES_ORG_LIMIT=0

# --- Fuel prices (optional) -----------------------------------------------------------------------

# Prices proposed in the refueling form, from the Italian MIMIT open data (stations and prices
# downloaded once a day, ~7 MB). Set to false outside Italy.
#FUEL_PRICES_ENABLED=true
